<% content_for :title, "dachs.link — encurtador de URL" %>

<div class="shortener" data-controller="dachs">
  <h1>dachs<span class="dot">.link</span></h1>
  <p class="tagline">cole a URL na barriga do salsichinha 🌭</p>

  <div class="stage">
    <div class="fit">
      <div class="shadow"></div>

      <div class="dachs" data-dachs-target="dog">
        <div class="heart" data-dachs-target="heart" aria-hidden="true">💛</div>

        <%= render "head" %>

        <div class="dachs__body" data-action="click->dachs#copy">
          <div class="body-slot">
            <%= form_with model: @link, url: links_path, id: "link_form", class: "url-form",
                          data: { action: "turbo:submit-start->dachs#squeeze turbo:submit-end->dachs#settle" } do |form| %>
              <%= form.text_field :original_url,
                    class: "url-input",
                    placeholder: "https://exemplo.com/uma-url-bem-comprida-mesmo",
                    spellcheck: false, autocomplete: "off", autocapitalize: "off",
                    inputmode: "url",
                    "aria-label": "URL para encurtar",
                    data: { dachs_target: "input",
                            action: "focus->dachs#alert blur->dachs#relax input->dachs#typing" } %>
            <% end %>

            <div id="short_result" class="short-view">
              <%= render "short_link", link: nil %>
            </div>
          </div>
        </div>

        <%= render "rear" %>
      </div>
    </div>
  </div>

  <div class="controls">
    <button type="submit" form="link_form" class="shorten-btn" data-dachs-target="submit">
      Encurtar! 🌭
    </button>

    <p class="hint" id="form_hint" data-dachs-target="hint" role="status"></p>

    <button type="button" class="reset-btn" data-dachs-target="reset"
            data-action="dachs#reset" hidden>encurtar outra</button>
  </div>
</div>
